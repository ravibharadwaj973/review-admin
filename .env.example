# Address of the ReviewRankr backend API (no trailing slash) — the same one the business app uses.
#   Local:      BACKEND_URL=http://localhost:4000
#   Production: BACKEND_URL=https://review.jharavi.in
# Copy this file to .env.local for local development. On Vercel, add it under
# Project → Settings → Environment Variables, then redeploy (it is read at build time).
BACKEND_URL=http://localhost:4000
